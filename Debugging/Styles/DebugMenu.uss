/* Debug menu base style. Colors are variables, override them in a project theme sheet. */

/* Dropdown lists open on the panel root, outside the host, so they need the variables too */
.dm-host,
.unity-base-dropdown {
    --dm-bg: #020617;
    --dm-surface: #0f172a;
    --dm-raised: #1e293b;
    --dm-control: #334155;
    --dm-control-hover: #475569;
    --dm-text: #f1f5f9;
    --dm-muted: #94a3b8;
    --dm-subtle: #64748b;
    --dm-faint: #475569;
    --dm-accent: #38bdf8;
    --dm-accent-soft: rgba(56, 189, 248, 0.16);
    --dm-on-accent: #020617;
    --dm-error: #f87171;
    --dm-error-soft: rgba(248, 113, 113, 0.16);
    --dm-warning: #fbbf24;
    --dm-warning-soft: rgba(251, 191, 36, 0.16);
    --dm-radius: 8px;
    --dm-card-radius: 12px;
}

.dm-host .unity-base-text-field__input {
    --unity-cursor-color: var(--dm-accent);
    --unity-selection-color: var(--dm-accent-soft);
}

/* Dropdown list */

.unity-base-dropdown {
    color: var(--dm-text);
}

.unity-base-dropdown__container-outer {
    min-width: 200px;
    padding: 4px;
    border-width: 1px;
    border-color: var(--dm-control);
    border-radius: var(--dm-radius);
    background-color: var(--dm-raised);
}

.unity-base-dropdown__container-inner {
    border-width: 0;
    background-color: transparent;
}

.unity-base-dropdown__item {
    height: 34px;
    padding: 0 8px;
    border-radius: 6px;
    background-color: transparent;
}

.unity-base-dropdown__item:hover {
    background-color: var(--dm-control);
}

.unity-base-dropdown__item:checked {
    background-color: var(--dm-accent-soft);
}

.unity-base-dropdown__label {
    color: var(--dm-text);
    font-size: 16px;
}

.unity-base-dropdown .unity-scroller--horizontal {
    display: none;
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: var(--dm-accent);
}

.unity-base-dropdown__separator {
    height: 1px;
    margin: 4px 0;
    background-color: var(--dm-control);
}

/* Root */

.dm-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    background-color: var(--dm-bg);
    color: var(--dm-text);
    font-size: 16px;
    overflow: hidden;
}

.dm-root Label {
    color: var(--dm-text);
    padding: 0;
    margin: 0;
}

.dm-icon {
    font-size: 22px;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
}

/* Generic buttons */

.dm-root Button {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: var(--dm-radius);
    background-color: transparent;
    color: var(--dm-text);
    -unity-font-style: bold;
    font-size: 16px;
}

.dm-icon-button {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.dm-icon-button .dm-icon {
    color: var(--dm-muted);
    font-size: 22px;
}

.dm-root .dm-icon-button:hover {
    background-color: var(--dm-raised);
}

/* Sidebar */

.dm-sidebar {
    width: 208px;
    flex-shrink: 0;
    padding: 10px 8px;
    background-color: var(--dm-surface);
}

.dm-brand {
    height: 40px;
    flex-direction: row;
    align-items: center;
    padding: 0 6px;
    margin-bottom: 4px;
}

.dm-brand__icon {
    width: 30px;
    height: 30px;
    font-size: 20px;
    border-radius: var(--dm-radius);
    background-color: #c4b5fd;
    color: #1e293b;
}

.dm-root .dm-brand__label {
    margin-left: 10px;
    font-size: 18px;
    -unity-font-style: bold;
}

.dm-sidebar__scroll {
    flex-grow: 1;
}

.dm-nav-list {
    flex-direction: column;
}

.dm-root .dm-sidebar__caption {
    padding: 10px 10px 2px;
    margin-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--dm-raised);
    font-size: 14px;
    color: var(--dm-subtle);
}

.dm-root .dm-sidebar__version {
    padding: 4px 10px 0;
    font-size: 13px;
    color: var(--dm-faint);
}

.dm-root .dm-nav-item {
    height: 36px;
    flex-direction: row;
    align-items: center;
    padding: 0 8px 0 10px;
    margin-bottom: 2px;
    -unity-font-style: normal;
}

.dm-root .dm-nav-item:hover {
    background-color: var(--dm-raised);
}

.dm-root .dm-nav-item__icon {
    color: var(--dm-muted);
    font-size: 20px;
    margin-right: 10px;
}

.dm-root .dm-nav-count {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--dm-subtle);
}

.dm-root .dm-nav-item__label {
    flex-grow: 1;
    color: var(--dm-muted);
    -unity-text-align: middle-left;
}

.dm-root .dm-nav-item--selected {
    background-color: var(--dm-accent-soft);
}

.dm-nav-item--selected .dm-nav-item__icon,
.dm-root .dm-nav-item--selected .dm-nav-item__label {
    color: var(--dm-accent);
    -unity-font-style: bold;
}

/* Main area */

.dm-main {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
}

.dm-header {
    height: 56px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
}

.dm-header__spacer {
    flex-grow: 1;
}

.dm-header__extra,
.dm-header__group {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.dm-root .dm-header__done {
    height: 30px;
    padding: 0 14px;
    margin: 0 4px;
    border-radius: 15px;
    background-color: var(--dm-accent);
    color: var(--dm-on-accent);
    font-size: 14px;
}

/* Narrow: page chips and tool controls below the header */
.dm-subheader {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 0 16px 8px;
}

.dm-subheader .dm-pages {
    flex-grow: 1;
}

.dm-subheader .dm-header__extra {
    flex-shrink: 1;
    flex-wrap: wrap;
}

/* Search in the header */

.dm-search {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 40px;
    flex-direction: row;
    align-items: center;
    padding: 0 2px 0 10px;
    margin: 0 4px 0 8px;
    border-radius: var(--dm-radius);
    background-color: var(--dm-raised);
    border-width: 2px;
    border-color: var(--dm-accent);
}

.dm-root .dm-search__icon {
    font-size: 20px;
    color: var(--dm-muted);
    margin-right: 6px;
}

.dm-root .dm-search__field {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}

.dm-root .dm-search__field .unity-base-text-field__input {
    height: 36px;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    color: var(--dm-text);
    font-size: 18px;
}

.dm-root .dm-search__field .unity-base-text-field__input--placeholder {
    color: var(--dm-subtle);
}

.dm-root .dm-search__info {
    margin: 0 6px;
    font-size: 14px;
    color: var(--dm-subtle);
}

.dm-root .dm-search__close {
    width: 32px;
    height: 32px;
}

.dm-search__pages {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px 16px 0;
}

.dm-header__menu {
    display: none;
}

.dm-crumbs {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
    margin-left: 8px;
}

.dm-root .dm-crumb {
    height: 32px;
    padding: 0 6px;
    font-size: 16px;
    color: var(--dm-muted);
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    flex-shrink: 0;
}

.dm-root .dm-crumb__separator {
    font-size: 18px;
    color: var(--dm-faint);
}

.dm-root .dm-title {
    margin-left: 6px;
    font-size: 20px;
    -unity-font-style: bold;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Page chips, scroll sideways when they overflow */

.dm-pages {
    flex-shrink: 1;
    min-width: 0;
    height: 36px;
}

.dm-pages .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: center;
}

.dm-root .dm-chip {
    height: 32px;
    flex-direction: row;
    align-items: center;
    padding: 0 6px 0 10px;
    margin: 2px 6px 2px 0;
    border-radius: 16px;
    background-color: var(--dm-raised);
    flex-shrink: 0;
}

.dm-root .dm-chip:hover {
    background-color: var(--dm-control);
}

.dm-root .dm-chip__icon {
    font-size: 18px;
    color: var(--dm-muted);
    margin-right: 5px;
}

.dm-root .dm-chip__label {
    -unity-font-style: bold;
}

.dm-root .dm-chip__chevron {
    font-size: 18px;
    color: var(--dm-subtle);
    margin-left: 4px;
}

.dm-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.dm-root .dm-empty {
    margin: 16px;
    color: var(--dm-subtle);
}

/* Narrow layout: sidebar becomes a drawer */

.dm-root--narrow .dm-header__menu {
    display: flex;
}

.dm-root--narrow .dm-sidebar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 280px;
    translate: -100% 0;
    transition-property: translate;
    transition-duration: 0.2s;
}

.dm-root--narrow.dm-root--drawer-open .dm-sidebar {
    translate: 0 0;
}

.dm-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(2, 6, 23, 0.6);
    display: none;
}

.dm-root--drawer-open .dm-scrim {
    display: flex;
}

/* Page content */

.dm-page {
    flex-grow: 1;
}

.dm-page__scroll {
    flex-grow: 1;
}

.dm-columns {
    flex-direction: row;
    align-items: flex-start;
    /* Right padding plus the last column margin gives 16px */
    padding: 4px 4px 16px 16px;
}

.dm-column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 12px;
}

.dm-card {
    padding: 0 12px 6px;
    margin-bottom: 12px;
    border-radius: var(--dm-card-radius);
    background-color: var(--dm-surface);
}

.dm-card--untitled {
    padding-top: 4px;
}

.dm-card__header {
    height: 40px;
    flex-direction: row;
    align-items: center;
}

.dm-root .dm-card__title {
    flex-grow: 1;
    font-size: 18px;
    -unity-font-style: bold;
}

.dm-root .dm-card__chevron {
    color: var(--dm-subtle);
}

/* Search results and favourites: card titled by the section path */

.dm-root .dm-card__path {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 15px;
    color: var(--dm-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dm-root .dm-card__open {
    width: 32px;
    height: 32px;
}

.dm-root .dm-card__open .dm-icon {
    font-size: 18px;
    color: var(--dm-subtle);
}

/* Pick mode: control is inert, the star toggles the favourite */

.dm-pick-row {
    flex-direction: row;
    align-items: center;
    margin: 0 -6px;
    padding: 0 6px;
    border-radius: var(--dm-radius);
}

.dm-pick-row:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.dm-pick-row__view {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    opacity: 0.6;
}

.dm-pick-row--on .dm-pick-row__view {
    opacity: 1;
}

.dm-pick-row__blocker {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dm-pick-row__star {
    width: 28px;
    height: 28px;
    margin-left: 8px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.05);
}

.dm-root .dm-pick-row__star .dm-icon {
    font-size: 18px;
    color: var(--dm-faint);
}

.dm-pick-row--on .dm-pick-row__star {
    background-color: var(--dm-warning-soft);
}

.dm-root .dm-pick-row--on .dm-pick-row__star .dm-icon {
    color: var(--dm-warning);
}

/* Text toggles: console Collapse and Source, profiler Pause, favourites Add */

.dm-root .dm-toggle {
    height: 32px;
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
    margin-left: 2px;
    border-radius: var(--dm-radius);
}

.dm-root .dm-toggle:hover {
    background-color: var(--dm-raised);
}

.dm-root .dm-toggle__icon {
    font-size: 20px;
    color: var(--dm-muted);
    margin-right: 4px;
}

.dm-root .dm-toggle__label {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--dm-muted);
}

.dm-root .dm-toggle--on {
    background-color: var(--dm-accent-soft);
}

.dm-root .dm-toggle--on .dm-toggle__icon,
.dm-root .dm-toggle--on .dm-toggle__label {
    color: var(--dm-accent);
}

.dm-card--collapsed {
    padding-bottom: 4px;
}

/* Rows */

.dm-row {
    min-height: 44px;
    flex-direction: row;
    align-items: center;
}

/* Label keeps its width, long values get cut instead */
.dm-root .dm-row__label {
    flex-grow: 1;
    flex-shrink: 0;
    margin-right: 12px;
    font-size: 18px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dm-row--clickable:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

.dm-row--buttons {
    flex-wrap: wrap;
    padding: 6px 0;
}

.dm-root .dm-value {
    font-size: 16px;
    color: var(--dm-muted);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dm-root .dm-unit {
    margin-left: 8px;
    color: var(--dm-subtle);
}

/* Buttons */

.dm-root .dm-button {
    height: 34px;
    padding: 0 14px;
    margin: 3px 6px 3px 0;
    background-color: var(--dm-control);
}

.dm-root .dm-button:hover {
    background-color: var(--dm-control-hover);
}

.dm-root .dm-button--primary {
    background-color: var(--dm-accent);
    color: var(--dm-on-accent);
}

.dm-root .dm-button--danger {
    background-color: var(--dm-error-soft);
    color: var(--dm-error);
}

.dm-root .dm-button--armed {
    background-color: var(--dm-error);
    color: var(--dm-bg);
}

/* Actions with arguments */

.dm-row--action {
    flex-direction: column;
    align-items: stretch;
    padding: 2px 10px 10px;
    margin: 4px 0;
    border-radius: 10px;
    background-color: var(--dm-raised);
}

.dm-action__header {
    height: 36px;
    flex-direction: row;
    align-items: center;
}

.dm-root .dm-action__icon {
    font-size: 20px;
    color: var(--dm-muted);
    margin-right: 8px;
}

.dm-root .dm-action__title {
    flex-grow: 1;
    font-size: 18px;
    -unity-font-style: bold;
}

.dm-action__arg {
    min-height: 44px;
}

.dm-action__arg .dm-row__label {
    font-size: 16px;
}

.dm-root .dm-row--action .dm-field .unity-base-text-field__input,
.dm-root .dm-row--action .dm-field .unity-base-popup-field__input,
.dm-root .dm-row--action .dm-stepper {
    background-color: var(--dm-surface);
}

.dm-root .dm-action__run {
    margin: 6px 0 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.dm-root .dm-action__run Label {
    color: var(--dm-on-accent);
    -unity-font-style: bold;
}

.dm-root .dm-action__run-icon {
    color: var(--dm-on-accent);
    margin-right: 6px;
}

.dm-action__chips {
    flex-direction: row;
    flex-wrap: wrap;
}

.dm-root .dm-option-chip {
    height: 32px;
    padding: 0 12px;
    margin: 0 6px 6px 0;
    border-radius: 16px;
    background-color: var(--dm-control);
}

.dm-root .dm-option-chip:hover {
    background-color: var(--dm-control-hover);
}

.dm-root .dm-option-chip--selected {
    background-color: var(--dm-accent);
    color: var(--dm-on-accent);
}

.dm-action__result-row {
    height: 40px;
    margin-top: 4px;
    flex-direction: row;
    align-items: center;
}

.dm-root .dm-action__result {
    color: #4ade80;
}

/* Switch */

.dm-switch {
    width: 44px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 13px;
    background-color: var(--dm-control);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.dm-switch__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: #ffffff;
    transition-property: left;
    transition-duration: 0.15s;
}

.dm-switch--on {
    background-color: var(--dm-accent);
}

.dm-switch--on .dm-switch__knob {
    left: 21px;
}

.dm-switch--readonly {
    opacity: 0.6;
}

/* Fields */

.dm-root .dm-field {
    margin: 0;
    width: 140px;
    flex-shrink: 0;
}

.dm-root .dm-field--text {
    width: 140px;
}

.dm-root .dm-field--number {
    width: 96px;
}

.dm-root .dm-field .unity-base-text-field__input,
.dm-root .dm-field .unity-base-popup-field__input {
    height: 34px;
    padding: 0 10px;
    margin: 0;
    border-width: 0;
    border-radius: var(--dm-radius);
    background-color: var(--dm-raised);
    color: var(--dm-text);
    font-size: 18px;
}

.dm-root .dm-field:focus .unity-base-text-field__input {
    border-width: 2px;
    border-color: var(--dm-accent);
}

.dm-root .dm-field .unity-text-element {
    color: var(--dm-text);
}

.dm-root .dm-field .unity-base-popup-field__text {
    flex-shrink: 1;
    margin-right: 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dm-root .dm-field .unity-base-text-field__input--placeholder,
.dm-root .dm-field .unity-base-text-field__input--placeholder .unity-text-element,
.dm-root .dm-search__field .unity-base-text-field__input--placeholder .unity-text-element {
    color: var(--dm-subtle);
}

.dm-root .dm-search__field .unity-text-element {
    color: var(--dm-text);
}

.dm-root .dm-field .unity-base-popup-field__arrow {
    width: 12px;
    height: 12px;
    -unity-background-image-tint-color: var(--dm-muted);
}

/* Stepper */

.dm-stepper {
    flex-direction: row;
    align-items: center;
    padding: 3px;
    border-radius: var(--dm-radius);
    background-color: var(--dm-raised);
}

.dm-root .dm-stepper__button {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background-color: var(--dm-control);
    font-size: 20px;
}

.dm-root .dm-stepper__button:hover {
    background-color: var(--dm-control-hover);
}

.dm-root .dm-stepper__field {
    width: 44px;
    margin: 0 2px;
}

.dm-root .dm-stepper__field .unity-base-text-field__input {
    height: 28px;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    color: var(--dm-text);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Slider */

.dm-row--slider {
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    min-height: 56px;
}

.dm-slider__header {
    flex-direction: row;
    align-items: center;
}

.dm-root .dm-slider {
    margin: 6px 0 0;
}

.dm-root .dm-slider .unity-base-slider__drag-container {
    height: 18px;
}

.dm-root .dm-slider .unity-base-slider__tracker {
    height: 4px;
    margin-top: -2px;
    border-width: 0;
    border-radius: 2px;
    background-color: var(--dm-control);
}

.dm-root .dm-slider .unity-base-slider__dragger {
    width: 18px;
    height: 18px;
    margin-top: -9px;
    border-width: 0;
    border-radius: 9px;
    background-color: #ffffff;
}

/* Scrollbars: thin, no arrow buttons */

.dm-root .unity-scroller--vertical,
.unity-base-dropdown .unity-scroller--vertical {
    width: 4px;
    margin-left: 2px;
    border-width: 0;
    background-color: transparent;
}

.dm-root .unity-scroller--horizontal,
.unity-base-dropdown .unity-scroller--horizontal {
    height: 4px;
    margin-top: 2px;
    border-width: 0;
    background-color: transparent;
}

.dm-root .unity-scroller__low-button,
.unity-base-dropdown .unity-scroller__low-button,
.dm-root .unity-scroller__high-button,
.unity-base-dropdown .unity-scroller__high-button {
    display: none;
}

/* Slider, drag container and dragger keep Unity's 24px unless sized too */
.dm-root .unity-scroller--vertical .unity-scroller__slider,
.unity-base-dropdown .unity-scroller--vertical .unity-scroller__slider,
.dm-root .unity-scroller--vertical .unity-base-slider__drag-container,
.unity-base-dropdown .unity-scroller--vertical .unity-base-slider__drag-container,
.dm-root .unity-scroller--vertical .unity-base-slider__dragger,
.unity-base-dropdown .unity-scroller--vertical .unity-base-slider__dragger {
    width: 4px;
    min-width: 4px;
    left: 0;
    margin-left: 0;
    margin-right: 0;
}

.dm-root .unity-scroller--horizontal .unity-scroller__slider,
.unity-base-dropdown .unity-scroller--horizontal .unity-scroller__slider,
.dm-root .unity-scroller--horizontal .unity-base-slider__drag-container,
.unity-base-dropdown .unity-scroller--horizontal .unity-base-slider__drag-container,
.dm-root .unity-scroller--horizontal .unity-base-slider__dragger,
.unity-base-dropdown .unity-scroller--horizontal .unity-base-slider__dragger {
    height: 4px;
    min-height: 4px;
    top: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.dm-root .unity-scroller .unity-base-slider__tracker,
.unity-base-dropdown .unity-scroller .unity-base-slider__tracker {
    border-width: 0;
    background-color: transparent;
}

.dm-root .unity-scroller .unity-base-slider__dragger,
.unity-base-dropdown .unity-scroller .unity-base-slider__dragger {
    margin: 0;
    border-width: 0;
    border-radius: 2px;
    background-color: var(--dm-control);
}

/* Console */

.dm-console {
    flex-grow: 1;
    padding: 0 16px 16px;
}

.dm-console__toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
}

.dm-console__divider {
    width: 1px;
    height: 20px;
    margin: 0 6px;
    background-color: var(--dm-raised);
}

.dm-root .dm-console__clear {
    height: 32px;
    min-width: 32px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0 6px;
    border-radius: var(--dm-radius);
}

.dm-root .dm-console__clear:hover {
    background-color: var(--dm-raised);
}

.dm-root .dm-console__clear-icon {
    font-size: 20px;
    color: var(--dm-muted);
}

.dm-root .dm-console__clear-label {
    display: none;
    margin-left: 4px;
    font-size: 14px;
    -unity-font-style: bold;
}

.dm-root .dm-console__clear--armed {
    background-color: var(--dm-error);
}

.dm-root .dm-console__clear--armed .dm-console__clear-icon,
.dm-root .dm-console__clear--armed .dm-console__clear-label {
    color: var(--dm-bg);
}

.dm-root .dm-console__clear--armed .dm-console__clear-label {
    display: flex;
}

.dm-subheader .dm-console__toolbar {
    flex-wrap: wrap;
    flex-grow: 1;
}

.dm-root .dm-filter {
    height: 32px;
    flex-direction: row;
    align-items: center;
    padding: 0 10px 0 8px;
    margin: 2px 6px 2px 0;
    border-radius: 16px;
    background-color: var(--dm-raised);
    opacity: 0.5;
}

.dm-root .dm-filter--on {
    opacity: 1;
}

.dm-root .dm-filter__icon {
    font-size: 18px;
    color: var(--dm-muted);
    margin-right: 4px;
}

.dm-root .dm-filter__count {
    -unity-font-style: bold;
}

.dm-level--log.dm-icon,
.dm-level--log .dm-icon {
    color: var(--dm-muted);
}

.dm-level--warning.dm-icon,
.dm-level--warning .dm-icon,
.dm-root .dm-level--warning .dm-filter__count {
    color: var(--dm-warning);
}

.dm-level--error.dm-icon,
.dm-level--error .dm-icon,
.dm-root .dm-level--error .dm-filter__count {
    color: var(--dm-error);
}

.dm-root .dm-console__search {
    width: 200px;
    flex-shrink: 1;
    min-width: 120px;
    margin: 2px 4px 2px 2px;
}

.dm-subheader .dm-console__search {
    flex-grow: 1;
}

.dm-root .dm-console__search .unity-base-text-field__input {
    height: 32px;
    font-size: 16px;
}

/* Scrollbar stays inside the card */
.dm-console__list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 120px;
    padding: 4px;
    overflow: hidden;
    border-radius: var(--dm-card-radius);
    background-color: var(--dm-surface);
}

.dm-root .dm-console__list .unity-scroller--vertical {
    margin: 2px 0 2px 4px;
}

.dm-root .dm-console__list .unity-collection-view__item {
    background-color: transparent;
    border-radius: var(--dm-radius);
}

.dm-root .dm-console__list .unity-collection-view__item--selected {
    background-color: var(--dm-accent-soft);
}

.dm-root .dm-console__empty {
    padding: 48px 16px;
    font-size: 16px;
    color: var(--dm-subtle);
    -unity-text-align: middle-center;
}

.dm-log {
    height: 100%;
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
    border-radius: 6px;
}

.dm-root .dm-log__icon {
    font-size: 18px;
    margin-right: 8px;
}

.dm-log__texts {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.dm-root .dm-log__title {
    font-size: 16px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dm-root .dm-log__source {
    font-size: 12px;
    color: var(--dm-subtle);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dm-root .dm-log__count {
    height: 22px;
    padding: 0 8px;
    margin-left: 8px;
    border-radius: 11px;
    background-color: var(--dm-control);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dm-root .dm-log__time {
    margin-left: 12px;
    font-size: 13px;
    color: var(--dm-subtle);
}

.dm-console__detail {
    height: 40%;
    flex-shrink: 0;
    margin-top: 10px;
    padding: 4px 10px 10px;
    border-radius: var(--dm-card-radius);
    background-color: var(--dm-surface);
}

.dm-console__detail-header {
    height: 38px;
    flex-direction: row;
    align-items: center;
}

.dm-root .dm-console__detail-header .dm-icon-button {
    width: 30px;
    height: 30px;
    margin-left: 4px;
}

.dm-root .dm-console__detail-header .dm-icon-button .dm-icon {
    font-size: 18px;
}

.dm-root .dm-console__detail-title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dm-console__detail-text {
    flex-grow: 1;
}

/* Text view: console stack trace and ShowText */

.dm-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    border-radius: var(--dm-radius);
    background-color: var(--dm-bg);
}

.dm-text__scroll {
    flex-grow: 1;
}

.dm-text__scroll .unity-scroll-view__content-container {
    padding: 8px 12px;
    min-width: 100%;
}

.dm-root .dm-text__label {
    font-size: 14px;
    color: var(--dm-muted);
    white-space: nowrap;
    -unity-text-align: upper-left;
}

.dm-root .dm-text--wrap .dm-text__label {
    white-space: normal;
}

.dm-root .dm-text--right .dm-text__label {
    -unity-text-align: upper-right;
}

.dm-text-preview {
    flex-grow: 1;
    padding: 0 16px 16px;
}

.dm-text-preview__toolbar {
    height: 40px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.dm-root .dm-text-preview__info {
    flex-grow: 1;
    font-size: 15px;
    color: var(--dm-subtle);
}

.dm-text-preview .dm-text {
    background-color: var(--dm-surface);
    border-radius: var(--dm-card-radius);
}

.dm-root .dm-text-preview .dm-text__label {
    font-size: 15px;
    color: var(--dm-text);
}

.dm-root .dm-icon-button--on {
    background-color: var(--dm-accent-soft);
}

.dm-root .dm-icon-button--on .dm-icon {
    color: var(--dm-accent);
}

/* Count badges */

.dm-badges {
    flex-direction: row;
    align-items: center;
}

.dm-badge {
    height: 22px;
    flex-direction: row;
    align-items: center;
    padding: 0 7px;
    margin-left: 4px;
    border-radius: 11px;
}

.dm-badge.dm-level--warning {
    background-color: var(--dm-warning-soft);
}

.dm-badge.dm-level--error {
    background-color: var(--dm-error-soft);
}

.dm-root .dm-badge__count,
.dm-host .dm-badge__count {
    font-size: 13px;
    -unity-font-style: bold;
}

.dm-level--warning .dm-badge__count {
    color: var(--dm-warning);
}

.dm-level--error .dm-badge__count {
    color: var(--dm-error);
}

/* Sidebar: solid dot */
.dm-badges--compact .dm-badge.dm-level--warning {
    background-color: var(--dm-warning);
}

.dm-badges--compact .dm-badge.dm-level--error {
    background-color: var(--dm-error);
}

.dm-badges--compact .dm-badge .dm-badge__count {
    color: var(--dm-on-accent);
}
.dm-root .dm-badge__icon {
    font-size: 18px;
    margin-right: 4px;
}

/* Corner trigger */

.dm-trigger {
    position: absolute;
    left: 0;
    top: 0;
}

.dm-trigger__area {
    width: 80px;
    height: 80px;
    border-bottom-right-radius: 16px;
}

.dm-trigger__fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-bottom-right-radius: 16px;
    background-color: var(--dm-accent-soft);
    opacity: 0;
}

.dm-trigger__dot {
    position: absolute;
    left: 5px;
    top: 5px;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #ef4444;
    transition-property: opacity;
    transition-duration: 0.12s;
}

.dm-trigger__dot--dim {
    opacity: 0.15;
}

/* Toasts: top center, over the menu and the app. Bottom bars like a dock stay visible */

.dm-toasts {
    position: absolute;
    left: 0;
    right: 0;
    top: 10px;
    align-items: center;
}

.dm-toast {
    height: 36px;
    flex-direction: row;
    align-items: center;
    padding: 0 14px 0 10px;
    margin-bottom: 6px;
    border-radius: 18px;
    background-color: rgba(30, 41, 59, 0.96);
    opacity: 0;
    translate: 0 -8px;
    transition-property: opacity, translate;
    transition-duration: 0.2s, 0.2s;
}

.dm-toast--shown {
    opacity: 1;
    translate: 0 0;
}

.dm-host .dm-toast__icon {
    font-size: 18px;
    margin-right: 8px;
    color: var(--dm-muted);
}

.dm-host .dm-toast__label {
    padding: 0;
    margin: 0;
    font-size: 15px;
    color: var(--dm-text);
}

.dm-host .dm-toast--success .dm-toast__icon {
    color: #4ade80;
}

.dm-host .dm-toast--warning .dm-toast__icon {
    color: var(--dm-warning);
}

.dm-host .dm-toast--error .dm-toast__icon {
    color: var(--dm-error);
}

/* FPS counter, top right while the menu is closed */

.dm-fps {
    position: absolute;
    top: 8px;
    right: 8px;
    height: 24px;
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
    border-radius: 12px;
    background-color: rgba(2, 6, 23, 0.72);
}

.dm-host .dm-fps__value {
    padding: 0;
    margin: 0;
    font-size: 14px;
    -unity-font-style: bold;
    color: #4ade80;
}

.dm-host .dm-fps__unit {
    padding: 0;
    margin: 0 0 0 4px;
    font-size: 11px;
    color: var(--dm-muted);
}

.dm-host .dm-fps--warning .dm-fps__value {
    color: var(--dm-warning);
}

.dm-host .dm-fps--error .dm-fps__value {
    color: var(--dm-error);
}

/* Profiler */

.dm-profiler {
    flex-grow: 1;
}

.dm-profiler__scroll {
    flex-grow: 1;
}

.dm-profiler__scroll .unity-scroll-view__content-container {
    padding: 0 16px 16px;
}

.dm-profiler .dm-card {
    padding-bottom: 12px;
}

.dm-profiler__tiles {
    flex-direction: row;
    flex-wrap: wrap;
    margin-right: -12px;
}

.dm-tile {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 130px;
    padding: 8px 12px;
    margin: 0 12px 12px 0;
    border-radius: var(--dm-card-radius);
    background-color: var(--dm-surface);
}

.dm-root .dm-tile__label {
    font-size: 14px;
    color: var(--dm-muted);
}

.dm-tile__line {
    flex-direction: row;
    align-items: flex-end;
}

.dm-root .dm-tile__value {
    font-size: 26px;
    -unity-font-style: bold;
}

.dm-root .dm-tile--warning .dm-tile__value {
    color: var(--dm-warning);
}

.dm-root .dm-tile__unit {
    margin: 0 0 4px 4px;
    font-size: 15px;
    color: var(--dm-muted);
}

.dm-root .dm-tile__sub {
    font-size: 13px;
    color: var(--dm-subtle);
}

.dm-profiler__graph {
    height: 170px;
    border-radius: var(--dm-radius);
    background-color: var(--dm-bg);
    overflow: hidden;
}

.dm-profiler__target {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--dm-faint);
}

.dm-root .dm-profiler__target-label {
    position: absolute;
    left: 6px;
    padding: 0 5px;
    border-radius: 4px;
    background-color: var(--dm-raised);
    font-size: 12px;
    color: var(--dm-muted);
}

.dm-profiler__bottom {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    margin-right: -12px;
}

.dm-profiler__memory {
    flex-grow: 3;
    flex-basis: 0;
    min-width: 320px;
    margin-right: 12px;
}

.dm-profiler__actions {
    flex-grow: 2;
    flex-basis: 0;
    min-width: 220px;
    margin-right: 12px;
}

.dm-memory {
    height: 40px;
    flex-direction: row;
    align-items: center;
}

.dm-root .dm-memory__label {
    width: 96px;
    color: var(--dm-muted);
}

.dm-memory__bar {
    flex-grow: 1;
    height: 6px;
    border-radius: 3px;
    background-color: var(--dm-control);
}

.dm-memory__fill {
    height: 100%;
    border-radius: 3px;
    background-color: var(--dm-accent);
}

.dm-root .dm-memory__value {
    width: 150px;
    margin-left: 10px;
    font-size: 15px;
    -unity-text-align: middle-right;
}

.dm-root .dm-profiler__action {
    flex-direction: row;
    align-items: center;
    margin: 0 0 6px 0;
}

.dm-root .dm-profiler__action-icon {
    font-size: 20px;
    margin-right: 8px;
}
